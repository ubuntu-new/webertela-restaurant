// Ronny's Platform — Prisma schema
// Phase 0 (დამტკიცებული Firestore schema) → რელაციური Postgres
// i18n {en,ka} → Json სვეტები. ფული → Decimal(10,2). ID → cuid.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum CategoryType {
  food
  merch
}

enum ProductType {
  pizza
  item
  sticks
  drink
  merch
}

enum PromoMode {
  percent
  fixed
}

enum ComboPricingMode {
  fixed
  discount
}

enum SlotMode {
  fixed
  choice
}

enum DiscountType {
  student
  diplomatic
  employee
  loyalty
  promo
  custom
}

enum EmployeeRole {
  super_admin
  branch_manager
  cashier
  kitchen
  driver
}

/// Cash into or out of the drawer that was not a sale.
///
/// Without this the arithmetic is a lie in the one direction that matters: a
/// manager pays the vegetable supplier forty in cash, and at midnight the
/// drawer is forty short with a cashier's name against it. Every legitimate
/// reason money leaves a till has to be recordable, or the variance accuses
/// whoever happened to be standing there.
model CashMovement {
  id         String   @id @default(cuid())
  shiftId    String
  /// Negative leaves the drawer, positive goes in. One column rather than two,
  /// because a "paid out" of minus forty and a "paid in" of forty are the same
  /// arithmetic and splitting them invites one to be forgotten in a sum.
  amount     Decimal  @db.Decimal(10, 2)
  reason     String
  employeeId String?
  at         DateTime @default(now())

  shift    Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([shiftId])
}

enum ShiftStatus {
  open
  closed
}

enum OrderSource {
  web
  pos
  kiosk
  phone
}

enum FulfillmentType {
  delivery
  pickup
  dine_in
}

enum PaymentMethod {
  cash
  card
  split
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

enum OrderStatus {
  new
  confirmed
  preparing
  ready
  delivering
  completed
  cancelled
}

enum PointsEntryType {
  earn
  redeem
  adjust
  expire
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum OrderItemKind {
  product
  pizza
  half_and_half
  sticks
  combo
}

// ─────────────────────────────────────────────────────────────
// 1) ORGANIZATION / BRANCH / TERMINAL
// ─────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      Json // { en, ka }
  logo      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  orders   Order[]
}

model Branch {
  id        String  @id @default(cuid())
  orgId     String
  code      String  @unique // "TBS-01"
  name      Json

  /// Normalised name, for duplicate detection. See lib/name-key.ts — this is
  /// what makes "Mozzarella" and "mozzarella " the same thing to the software.
  nameKey   String?
  address   Json
  phone     String?
  hours     Json? // { mon: {open,close}, ... }
  lat       Float?
  lng       Float?
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  /// What this branch normally starts a drawer with.
  ///
  /// A suggestion and never an assumption. Some places put the same float in
  /// every morning; others keep whatever was left. Either way the cashier
  /// counts, and the *counted* number is what the arithmetic uses — because a
  /// drawer that was configured at 200 and actually held 180 would otherwise
  /// show a 20 shortfall tonight and blame the wrong shift for yesterday.
  openingFloat Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  terminals Terminal[]
  employees EmployeeBranch[]
  shifts    Shift[]
  orders    Order[]

  // არქივი: არაფერი იშლება ფიზიკურად — deletedAt ივსება და სიებიდან ქრება
  deletedAt DateTime?

  branchProducts BranchProduct[]

  stockLocation StockLocation?

  branchCombos BranchCombo[]

  @@index([orgId, active, sortOrder])
  @@index([deletedAt])
  @@index([nameKey])
}

model Terminal {
  id              String  @id @default(cuid())
  branchId        String
  posId           String  @unique // "TBS-01-POS-1"
  label           Json
  active          Boolean @default(true)
  hasCardTerminal Boolean @default(true)

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shifts Shift[]
  orders Order[]

  @@index([branchId])
}

// ─────────────────────────────────────────────────────────────
// 2) SETTINGS — key/value (settings/global დაშლილი ბლოკებად)
//    keys: order | loyalty | employeeDiscount | discountRules |
//          discountVerification | tax | social
// ─────────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ─────────────────────────────────────────────────────────────
// 3) CATEGORY / SUBCATEGORY
// ─────────────────────────────────────────────────────────────

model Category {
  id        String       @id @default(cuid())
  name      Json

  /// Normalised name, for duplicate detection. See lib/name-key.ts — this is
  /// what makes "Mozzarella" and "mozzarella " the same thing to the software.
  nameKey   String?
  icon      String?
  type      CategoryType @default(food)
  active    Boolean      @default(true)
  sortOrder Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories Subcategory[]
  products      Product[]
  discountRules DiscountRule[]

  // არქივი: არაფერი იშლება ფიზიკურად — deletedAt ივსება და სიებიდან ქრება
  deletedAt DateTime?

  @@index([active, sortOrder])
  @@index([deletedAt])
  @@index([nameKey])
}

model Subcategory {
  id         String  @id @default(cuid())
  categoryId String
  name       Json

  /// Normalised name, for duplicate detection. See lib/name-key.ts — this is
  /// what makes "Mozzarella" and "mozzarella " the same thing to the software.
  nameKey   String?
  active     Boolean @default(true)
  sortOrder  Int     @default(0)

  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products      Product[]
  discountRules DiscountRule[]

  // არქივი: არაფერი იშლება ფიზიკურად — deletedAt ივსება და სიებიდან ქრება
  deletedAt DateTime?

  @@index([categoryId, active, sortOrder])
  @@index([deletedAt])
  @@index([nameKey])
}

// ─────────────────────────────────────────────────────────────
// 4) PRODUCT / SIZE / PROMO / TOPPING
// ─────────────────────────────────────────────────────────────

model Product {
  id            String      @id @default(cuid())
  name          Json

  /// For anything sold in the packaging it arrived in — a bottled drink, a
  /// T-shirt. Prepared food has no barcode and never will, so this is null for
  /// most of the menu, which is correct rather than incomplete.
  barcode String? @unique

  /// Normalised name, for duplicate detection. See lib/name-key.ts — this is
  /// what makes "Mozzarella" and "mozzarella " the same thing to the software.
  nameKey   String?
  description   Json?
  categoryId    String
  subcategoryId String?
  type          ProductType @default(item)

  // ── capabilities ──
  // What a product *is* used to be a category; what it *supports* is a set of
  // flags. A pizza is hasSizes + hasModifiers + splittable. A burger is
  // hasModifiers. A latte is hasSizes + hasModifiers. Nothing in the type
  // system has to change when a bakery or a sushi place arrives — which is the
  // entire reason for the change. `type` stays until every read has moved off it.
  hasSizes     Boolean @default(false)
  hasModifiers Boolean @default(false)
  splittable   Boolean @default(false) // half-and-half — pizza only
  hasVariants  Boolean @default(false)
  sizeMeta     Json? // { cm: 32 } · { oz: 16 }
  taxable      Boolean @default(true)

  photo   String?
  gallery String[] @default([])

  nutrition Json? // { calories, protein, carbs, fat, allergens[] }

  // მარტივი პროდუქტი — ერთი ფასი; პიცა — sizes[]; merch — variants
  price    Decimal? @db.Decimal(10, 2)
  variants Json? // [ { name:{en,ka}, price } ]

  // ── საიტის UI-სთვის საჭირო ველები (lib/data.ts-იდან) ──
  legacyId Int?    @unique // ძველი რიცხვითი id (pizza:1) — HH_COMBOS/photos თავსებადობა
  emoji    String?
  builder  String? // "sticks" | "cinsticks" — რომელი კონსტრუქტორი გაიხსნას
  isBYO    Boolean @default(false) // „ჩემი პიცა“ — ნულიდან აწყობა

  tier  String?
  badge Json?

  discountable     Boolean  @default(true)
  active           Boolean  @default(true)
  disabledBranches String[] @default([]) // branchId-ები, სადაც არ იყიდება
  sortOrder        Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  category      Category         @relation(fields: [categoryId], references: [id])
  subcategory   Subcategory?     @relation(fields: [subcategoryId], references: [id])
  sizes         ProductSize[]
  promo         ProductPromo?
  ingredients   ProductTopping[]
  comboOptions  ComboSlotOption[]
  discountRules DiscountRule[]
  orderItems    OrderItem[]

  branchProducts BranchProduct[]

  consumption ConsumptionRule[]

  @@index([categoryId, active, sortOrder])
  // არქივი: არაფერი იშლება ფიზიკურად — deletedAt ივსება და სიებიდან ქრება
  deletedAt DateTime?

  @@index([type, active])
  @@index([deletedAt])
  @@index([nameKey])
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  key       String // "S" | "M" | "XL"
  cm        Int?
  meta      Json? // { cm: 32 } · { oz: 16 } · { serves: 4 } — replaces cm
  price     Decimal @db.Decimal(10, 2)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
}

model ProductPromo {
  id        String    @id @default(cuid())
  productId String    @unique
  active    Boolean   @default(false)
  mode      PromoMode @default(percent)
  value     Decimal   @db.Decimal(10, 2)
  sizes     String[]  @default([]) // ცარიელი = ყველა ზომაზე
  label     Json? // { en:"-20%", ka:"-20%" }
  validFrom DateTime?
  validTo   DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Topping {
  id         String   @id @default(cuid())
  name       Json

  /// Normalised name, for duplicate detection. See lib/name-key.ts — this is
  /// what makes "Mozzarella" and "mozzarella " the same thing to the software.
  nameKey   String?
  category   String? // "meat" | "veg" | "cheese" | "sauce"
  emoji      String?
  dots       String[] @default([]) // UI-ს ფერადი ნიშნულები
  ui         Json? // { dots: [...] } — constructor UI state, no longer a named field
  popular    Boolean  @default(false) // კონსტრუქტორში ზემოთ ჩნდება
  photo      String?
  recipeOnly Boolean @default(false) // მხოლოდ რეცეპტში, დამატებით არ იყიდება
  active     Boolean @default(true)
  sortOrder  Int     @default(0)

  prices   ToppingPrice[]
  products ProductTopping[]

  // არქივი: არაფერი იშლება ფიზიკურად — deletedAt ივსება და სიებიდან ქრება
  deletedAt DateTime?

  consumption ConsumptionRule[]

  @@index([active, sortOrder])
  @@index([deletedAt])
  @@index([nameKey])
}

model ToppingPrice {
  id        String  @id @default(cuid())
  toppingId String
  sizeKey   String // "S" | "M" | "XL"
  price     Decimal @db.Decimal(10, 2)

  topping Topping @relation(fields: [toppingId], references: [id], onDelete: Cascade)

  @@unique([toppingId, sizeKey])
}

// პროდუქტის ნაგულისხმევი ინგრედიენტები
model ProductTopping {
  productId String
  toppingId String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  topping Topping @relation(fields: [toppingId], references: [id], onDelete: Cascade)

  @@id([productId, toppingId])
}

// ─────────────────────────────────────────────────────────────
// 5) COMBO
// ─────────────────────────────────────────────────────────────

model Combo {
  id          String  @id @default(cuid())
  name        Json

  /// Normalised name, for duplicate detection. See lib/name-key.ts — this is
  /// what makes "Mozzarella" and "mozzarella " the same thing to the software.
  nameKey   String?
  description Json?
  photo       String?
  badge       Json?

  pricingMode ComboPricingMode @default(fixed)
  price       Decimal?         @db.Decimal(10, 2)
  percent     Decimal?         @db.Decimal(5, 2)

  discountable     Boolean   @default(false) // კომბო customer-discount-ს არ იღებს
  active           Boolean   @default(true)
  disabledBranches String[]  @default([])
  validFrom        DateTime?
  validTo          DateTime?
  sortOrder        Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots ComboSlot[]

  // არქივი: არაფერი იშლება ფიზიკურად — deletedAt ივსება და სიებიდან ქრება
  deletedAt DateTime?

  branchCombos BranchCombo[]

  @@index([active, sortOrder])
  @@index([deletedAt])
  @@index([nameKey])
}

model ComboSlot {
  id        String   @id @default(cuid())
  comboId   String
  label     Json
  mode      SlotMode @default(choice)
  sortOrder Int      @default(0)

  combo   Combo             @relation(fields: [comboId], references: [id], onDelete: Cascade)
  options ComboSlotOption[]

  @@index([comboId, sortOrder])
}

model ComboSlotOption {
  id        String @id @default(cuid())
  slotId    String
  productId String

  slot    ComboSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([slotId, productId])
}

// ─────────────────────────────────────────────────────────────
// 6) DISCOUNT — rules-based ძრავა
// ─────────────────────────────────────────────────────────────

model Discount {
  id                  String       @id @default(cuid())
  name                Json

  /// Normalised name, for duplicate detection. See lib/name-key.ts — this is
  /// what makes "Mozzarella" and "mozzarella " the same thing to the software.
  nameKey   String?
  type                DiscountType
  kindId              String? // replaces `type` once the reads have moved
  kind                DiscountKind? @relation(fields: [kindId], references: [id])
  active              Boolean      @default(false)
  validFrom           DateTime?
  validTo             DateTime?
  requiresVerification Boolean     @default(false)

  // default წესი — თუ item-ს კონკრეტული rule არ მოერგო
  defaultMode  PromoMode @default(percent)
  defaultValue Decimal   @default(0) @db.Decimal(10, 2)

  usageLimit Int?
  usedCount  Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules DiscountRule[]
  users UserDiscount[]

  // არქივი: ფიზიკურად არაფერი იშლება
  deletedAt DateTime?
  @@index([deletedAt])

  @@index([type, active])
  @@index([kindId])
  @@index([nameKey])
}

/// A discount kind the owner can add without a deployment.
/// `diplomatic` is a Georgian retail concept; a Monroe pizzeria wants
/// `first_responder` and `senior`. Adding one should be a row, not a release.
model DiscountKind {
  id        String   @id @default(cuid())
  code      String   @unique // "student" | "first_responder"
  label     Json // { en: "First responder" }
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  discounts Discount[]

  @@index([active, sortOrder])
}

// პრიორიტეტი item-ზე: productId > subcategoryId > categoryId > default
model DiscountRule {
  id         String @id @default(cuid())
  discountId String

  targetCategoryId    String?
  targetSubcategoryId String?
  targetProductId     String?

  mode  PromoMode @default(percent)
  value Decimal   @db.Decimal(10, 2)

  discount       Discount     @relation(fields: [discountId], references: [id], onDelete: Cascade)
  targetCategory Category?    @relation(fields: [targetCategoryId], references: [id])
  targetSubcat   Subcategory? @relation(fields: [targetSubcategoryId], references: [id])
  targetProduct  Product?     @relation(fields: [targetProductId], references: [id])

  @@index([discountId])
}

// ─────────────────────────────────────────────────────────────
// 7) CUSTOMER
// ─────────────────────────────────────────────────────────────

model User {
  id       String  @id @default(cuid())
  name     String?
  phone    String? @unique
  email    String? @unique
  photoURL String?

  loyaltyPoints    Int     @default(0)
  defaultAddressId String?

  orderCount Int     @default(0)
  totalSpent Decimal @default(0) @db.Decimal(12, 2)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastOrderAt DateTime?

  addresses     Address[]
  pointsLedger  PointsEntry[]
  discounts     UserDiscount[]
  verifications Verification[]
  orders        Order[]
}

model Address {
  id       String  @id @default(cuid())
  userId   String
  title    String?
  street   String
  building String?
  apt      String?
  entrance String?
  floor    String?
  note     String?
  lat      Float?
  lng      Float?
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PointsEntry {
  id        String          @id @default(cuid())
  userId    String
  type      PointsEntryType
  points    Int // + earn / − redeem
  orderId   String?
  reason    String?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserDiscount {
  id         String    @id @default(cuid())
  userId     String
  discountId String
  approvedBy String?
  approvedAt DateTime  @default(now())
  expiresAt  DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([userId, discountId])
}

model Verification {
  id         String             @id @default(cuid())
  userId     String
  type       DiscountType
  fileUrl    String?
  status     VerificationStatus @default(pending)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// 8) EMPLOYEE / SHIFT
// ─────────────────────────────────────────────────────────────

model Employee {
  id       String  @id @default(cuid())
  name     String

  /// Normalised name, for duplicate detection. See lib/name-key.ts — this is
  /// what makes "Mozzarella" and "mozzarella " the same thing to the software.
  nameKey   String?
  phone    String? @unique
  email    String? @unique
  photoURL String?

  passwordHash String? // admin panel login
  role         EmployeeRole
  permissions  String[]     @default([])

  homeBranchId String?
  posPinHash   String?      @unique // 6-ციფრიანი PIN, hash-ით; უნიკალური

  title      String?
  hourlyRate Decimal? @db.Decimal(10, 2)
  hiredAt    DateTime?
  active     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  EmployeeBranch[]
  shifts    Shift[]
  cashMoves CashMovement[]
  orders    Order[]          @relation("OrderCreatedBy")
  deliveries Order[]         @relation("OrderDriver")
  auditLogs AuditLog[]

  // არქივი: ფიზიკურად არაფერი იშლება
  deletedAt DateTime?
  @@index([deletedAt])

  @@index([role, active])
  @@index([nameKey])
}

model EmployeeBranch {
  employeeId String
  branchId   String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([employeeId, branchId])
}

model Shift {
  id         String      @id @default(cuid())
  employeeId String
  branchId   String
  posId      String?
  clockIn    DateTime    @default(now())
  clockOut   DateTime?
  breaks     Json        @default("[]") // [{start,end}]
  durationMin Int?
  status     ShiftStatus @default(open)
  approvedBy String?

  /// Counted at the start and at the end. Null means nobody counted, which is
  /// a different thing from zero and is never shown as one.
  openingCash Decimal? @db.Decimal(10, 2)
  closingCash Decimal? @db.Decimal(10, 2)
  /// What the cashier said about a difference, in their own words.
  cashNote    String?

  createdAt  DateTime    @default(now())

  employee Employee  @relation(fields: [employeeId], references: [id])
  branch   Branch    @relation(fields: [branchId], references: [id])
  terminal Terminal? @relation(fields: [posId], references: [posId])
  orders   Order[]
  cash     CashMovement[]

  @@index([employeeId, clockIn])
  @@index([branchId, status])
}

// ─────────────────────────────────────────────────────────────
// 9) ORDER
// ─────────────────────────────────────────────────────────────

model Order {
  id      String @id @default(cuid())
  orderNo Int    @unique @default(autoincrement())

  source            OrderSource
  orgId             String
  branchId          String
  posId             String?
  userId            String?
  createdByEmployee String?

  // ── ფასი (მხოლოდ სერვერი წერს) ──
  subtotal          Decimal @default(0) @db.Decimal(10, 2)
  discountBreakdown Json    @default("[]") // [{type, amount}]
  discountTotal     Decimal @default(0) @db.Decimal(10, 2)
  deliveryFee       Decimal @default(0) @db.Decimal(10, 2)
  tax               Decimal @default(0) @db.Decimal(10, 2)
  tip               Decimal @default(0) @db.Decimal(10, 2)
  pointsRedeemed    Int     @default(0)
  pointsValue       Decimal @default(0) @db.Decimal(10, 2)
  total             Decimal @default(0) @db.Decimal(10, 2)
  pointsEarned      Int     @default(0)

  // ── მიწოდება ──
  fulfillmentType FulfillmentType @default(delivery)
  address         Json?
  tableNo         String?
  scheduledFor    DateTime?

  customerName  String?
  customerPhone String?

  // ── გადახდა ──
  paymentMethod PaymentMethod @default(cash)
  paymentStatus PaymentStatus @default(unpaid)

  /// The shift that rang it up. Without it a sale belongs to a day rather than
  /// to a countable period, and a variance can never be narrowed to a person.
  shiftId String?
  /// The cash that crossed the counter.
  ///
  /// These two have been in the schema since the first migration and **nothing
  /// has ever read or written them** — which is exactly why "how much should be
  /// in the drawer" had no answer while the till computed both numbers, showed
  /// them, and threw them away. Adding new columns beside them was the first
  /// thing tried here and it was wrong twice: a duplicate field Prisma refuses,
  /// and a second definition of the same fact.
  ///
  /// Now nullable, because `NOT NULL DEFAULT 0` cannot say "nobody recorded
  /// this" — and telling a drawer count that a sale took zero cash is the
  /// difference between an honest gap and a false shortfall.
  paidAmount    Decimal?      @db.Decimal(10, 2)
  changeGiven   Decimal?      @db.Decimal(10, 2)
  terminalId    String?
  txnRef        String?

  // ── სტატუსი ──
  status        OrderStatus @default(new)
  statusHistory Json        @default("[]") // [{status, at, by}]

  driverId    String?
  assignedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id])
  branch      Branch       @relation(fields: [branchId], references: [id])
  terminal    Terminal?    @relation(fields: [posId], references: [posId])
  shift       Shift?       @relation(fields: [shiftId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])
  createdBy   Employee?    @relation("OrderCreatedBy", fields: [createdByEmployee], references: [id])
  driver      Employee?    @relation("OrderDriver", fields: [driverId], references: [id])
  items       OrderItem[]

  /// ტერმინალის მიერ გენერირებული uuid — იგივე შეკვეთის ხელახლა გაგზავნა უვნებელია
  clientRef String? @unique

  @@index([branchId, status, createdAt])
  @@index([userId, createdAt])
  @@index([branchId, source, createdAt])
  @@index([branchId, posId, createdAt])
  @@index([shiftId])
}

// შეკვეთის პოზიცია — immutable snapshot (მენიუს ცვლილება ძველ შეკვეთას არ ცვლის)
model OrderItem {
  id        String        @id @default(cuid())
  orderId   String
  kind      OrderItemKind
  productId String?
  comboId   String?

  name   Json // snapshot
  config Json  @default("{}") // ზომა, ტოპინგები, half&half და ა.შ.

  qty       Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  appliedDiscount Json? // { source, amount }

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// 10) AUDIT LOG
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  employeeId String?
  branchId   String?
  before     Json?
  after      Json?
  at         DateTime @default(now())

  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([entityType, entityId])
  @@index([at])
  @@index([employeeId, at])
  @@index([action, at])
  @@index([branchId, at])
}


/// პროდუქტის მდგომარეობა კონკრეტულ ფილიალში.
/// ჩანაწერის არარსებობა = ხელმისაწვდომია (ნაგულისხმევი).
/// stock/min/target მარაგის ეტაპისთვისაა — ახლა null-ია.
model BranchProduct {
  id        String @id @default(cuid())
  branchId  String
  productId String

  /// false = ამ ფილიალში დროებით არ იყიდება („გათავდა“)
  available Boolean @default(true)

  /// ცალობითი ნაშთი. null = ამ პროდუქტს რაოდენობით არ ვითვლით (მაგ. პიცა)
  stock       Int?
  /// ამ ზღვარზე ჩამოსვლა შევსების სიგნალია
  minLevel    Int?
  /// რამდენამდე უნდა შეივსოს
  targetLevel Int?

  note      String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([productId, available])
  @@index([branchId, available])
}


// ═══════════════════════════════════════════════
// საწყობი — ეტაპი 3A
// ═══════════════════════════════════════════════

enum StockLocationType {
  warehouse /// ცენტრალური საწარმო
  branch    /// ფილიალის სამზარეულო
}

enum StockUnit {
  g
  kg
  ml
  l
  pcs

  // imperial — US kitchens buy in these. Purely additive: nothing metric changes
  // meaning, and `Setting: units.system` decides which set the UI offers first.
  oz
  lb
  floz
  gal
  each
}

enum StockMoveType {
  receipt        /// მიღება მიმწოდებლისგან
  transfer_out   /// გაცემა სხვა ლოკაციაზე
  transfer_in    /// მიღება სხვა ლოკაციიდან
  production_in  /// წარმოებამ დაამზადა
  production_out /// წარმოებამ დახარჯა
  sale           /// შეკვეთაზე ჩამოწერა
  waste          /// ჩამოწერა (გაფუჭდა, დაიღვარა)
  count_adjust   /// ინვენტარიზაციის სხვაობა
}

/// სად ინახება მარაგი. ფილიალს თითო აქვს, პლუს ცენტრალური საწარმო.
model StockLocation {
  id       String            @id @default(cuid())
  name     Json
  type     StockLocationType
  branchId String?           @unique
  active   Boolean           @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  branch    Branch?         @relation(fields: [branchId], references: [id])
  levels    StockLevel[]
  movements StockMovement[]

  transfersOut Transfer[] @relation("TransferFrom")
  transfersIn  Transfer[] @relation("TransferTo")

  productionOrders ProductionOrder[]

  @@index([type, active])
  @@index([deletedAt])
}

/// ვისგან ყიდულობ. იდენტობისთვის და შესყიდვის ისტორიისთვის.
///
/// A supplier exists here for one narrow reason: most kitchen ingredients have
/// no barcode, and for those the only identifier that is not a typed name is
/// "the code this supplier uses for it". A sack of flour from the same mill with
/// the same order code is the same flour, whatever anybody typed in the name box.
model Supplier {
  id   String @id @default(cuid())
  name String

  /// Normalised name, for duplicate detection. See lib/name-key.ts.
  nameKey String?

  /// Your own short code for them, if you use one. Unique when set.
  code String? @unique

  phone   String?
  email   String?
  contact String?
  note    String?

  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items StockItem[]

  @@index([active])
  @@index([deletedAt])
  @@index([nameKey])
}

/// საწყობის ერთეული — ის, რასაც ინახავ (და არა ის, რასაც ყიდი).
/// მოცარელა კგ-ობით, კოკა-კოლა ცალობით, ფქვილი კგ-ობით.
model StockItem {
  id   String    @id @default(cuid())
  sku  String?   @unique
  name Json

  /// The barcode printed on the packaging, stored as GTIN-14 (zero-padded), so
  /// that the UPC-A on an American can and the EAN-13 on the same can in Europe
  /// are one value and not two rows. See lib/gtin.ts.
  ///
  /// Unique because a GTIN identifies a product globally — if two rows claim the
  /// same one, one of them is wrong. This is the only identity constraint in the
  /// schema strong enough to enforce at the database, because it is the only one
  /// a human did not invent.
  barcode String? @unique

  /// What one purchased pack contains: 500 + g, 1.5 + l, 12 + pcs.
  ///
  /// This is what stops the duplicate check crying wolf. "Coca-Cola 330 ml" and
  /// "Coca-Cola 1.5 L" share a name and are two real, different items; without a
  /// pack size the software has no way to know that and warns about both.
  packSize Decimal?   @db.Decimal(14, 3)
  packUnit StockUnit?

  /// Who it is bought from, and their code for it. For everything that arrives
  /// in an unlabelled sack and has no barcode at all — which in a kitchen is
  /// most of it.
  supplierId   String?
  supplierCode String?

  /// Normalised name, for duplicate detection. See lib/name-key.ts — this is
  /// what makes "Mozzarella" and "mozzarella " the same thing to the software.
  nameKey   String?
  unit StockUnit

  category String? /// "dairy" | "meat" | "veg" | "packaging" | "drink"

  /// true = საწარმოში მზადდება რეცეპტით (ცომი, სოუსი), არა ყიდულობ
  isProduced Boolean @default(false)

  note   String?
  active Boolean @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  levels    StockLevel[]
  movements StockMovement[]

  consumption ConsumptionRule[]

  transferLines TransferLine[]

  recipeOutputs Recipe[]         @relation("RecipeOutput")
  recipeInputs  RecipeLine[]
  productionLines ProductionLine[]

  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, supplierCode])
  @@index([active, category])
  @@index([deletedAt])
  @@index([nameKey])
  @@index([supplierId])
}

/// მიმდინარე ნაშთი ლოკაციაზე. `qty` მოძრაობების ჯამის ქეშია —
/// იმავე ტრანზაქციაში ახლდება და ნებისმიერ დროს გადაითვლება.
model StockLevel {
  id         String @id @default(cuid())
  locationId String
  itemId     String

  qty Decimal @default(0) @db.Decimal(14, 3)

  /// ამ ზღვარზე ჩამოსვლა შევსების სიგნალია
  minLevel    Decimal? @db.Decimal(14, 3)
  /// რამდენამდე უნდა შეივსოს
  targetLevel Decimal? @db.Decimal(14, 3)

  /// მოძრავი საშუალო ღირებულება ერთეულზე
  avgCost Decimal? @db.Decimal(14, 4)

  updatedAt DateTime @updatedAt

  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  item     StockItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([locationId, itemId])
  @@index([itemId])
}

/// ჟურნალი — ყველა მოძრაობა. აქედან გამომდინარეობს ნაშთი.
model StockMovement {
  id         String        @id @default(cuid())
  locationId String
  itemId     String
  type       StockMoveType

  /// + შემოსვლა, − გასვლა
  qty          Decimal  @db.Decimal(14, 3)
  /// ნაშთი ამ მოძრაობის შემდეგ — აუდიტისთვის
  balanceAfter Decimal? @db.Decimal(14, 3)

  /// რამ გამოიწვია: "Order" | "Transfer" | "ProductionOrder" | null (ხელით)
  /// ერთეულის ფასი ამ მოძრაობაზე (მიღებისას — შესყიდვის, ჩამოწერისას — მიმდინარე საშუალო)
  unitCost Decimal? @db.Decimal(14, 4)
  /// qty × unitCost — რამდენად შეიცვალა მარაგის ღირებულება
  totalCost Decimal? @db.Decimal(14, 2)

  refType String?
  refId   String?

  note       String?
  employeeId String?
  at         DateTime @default(now())

  location StockLocation @relation(fields: [locationId], references: [id])
  item     StockItem     @relation(fields: [itemId], references: [id])

  @@index([locationId, itemId, at])
  @@index([refType, refId])
  @@index([at])
}


/// რა იხარჯება საწყობიდან, როცა მენიუს პოზიცია იყიდება.
///
/// მფლობელი ერთია — ან პროდუქტი, ან ტოპინგი:
///   productId → ბაზა (ცომი, სოუსი, ყუთი; ან თავად კოკა-კოლა 1 ცალი)
///   toppingId → ტოპინგის ხარჯი (მოცარელა 0.18 კგ)
///
/// qty იმ ერთეულშია, რომელიც StockItem-ს აქვს.
model ConsumptionRule {
  id String @id @default(cuid())

  itemId String
  qty    Decimal @db.Decimal(14, 3)

  /// "S" | "M" | "XL" — ცარიელი ნიშნავს „ყველა ზომაზე"
  sizeKey String?

  productId String?
  toppingId String?

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item    StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  product Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  topping Topping?  @relation(fields: [toppingId], references: [id], onDelete: Cascade)

  @@unique([productId, toppingId, itemId, sizeKey])
  @@index([productId])
  @@index([toppingId])
  @@index([itemId])
}


enum TransferStatus {
  draft     /// იწერება
  requested /// ფილიალმა მოითხოვა
  approved  /// საწარმომ დაამტკიცა
  sent      /// გაიგზავნა — წყაროს ჩამოეწერა
  received  /// მიღებულია — დანიშნულებას დაემატა
  cancelled
}

/// გადატანა ლოკაციებს შორის.
model Transfer {
  id String @id @default(cuid())
  no Int    @unique @default(autoincrement())

  fromLocationId String
  toLocationId   String

  status TransferStatus @default(draft)
  note   String?

  /// თითო ეტაპს თავისი პასუხისმგებელი
  requestedById String?
  approvedById  String?
  sentById      String?
  receivedById  String?
  cancelledById String?

  requestedAt DateTime?
  approvedAt  DateTime?
  sentAt      DateTime?
  receivedAt  DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  from  StockLocation  @relation("TransferFrom", fields: [fromLocationId], references: [id])
  to    StockLocation  @relation("TransferTo", fields: [toLocationId], references: [id])
  lines TransferLine[]

  @@index([status, createdAt])
  @@index([toLocationId, status])
  @@index([fromLocationId, status])
}

/// მოთხოვნილი / გაგზავნილი / მიღებული — სამივე ცალკე, რომ სხვაობა ჩანდეს.
model TransferLine {
  id         String @id @default(cuid())
  transferId String
  itemId     String

  qtyRequested Decimal  @db.Decimal(14, 3)
  qtyApproved  Decimal? @db.Decimal(14, 3)
  qtySent      Decimal? @db.Decimal(14, 3)
  qtyReceived  Decimal? @db.Decimal(14, 3)

  note String?

  transfer Transfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     StockItem @relation(fields: [itemId], references: [id])

  @@unique([transferId, itemId])
  @@index([itemId])
}


/// წარმოების რეცეპტი: შემავალები → გამოსავალი.
/// outputQty არის ერთი გატარების შედეგი (მაგ. 100 გუნდა).
model Recipe {
  id   String @id @default(cuid())
  name Json

  /// Normalised name, for duplicate detection. See lib/name-key.ts — this is
  /// what makes "Mozzarella" and "mozzarella " the same thing to the software.
  nameKey   String?

  outputItemId String
  outputQty    Decimal @db.Decimal(14, 3)

  note   String?
  active Boolean @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  outputItem StockItem         @relation("RecipeOutput", fields: [outputItemId], references: [id])
  lines      RecipeLine[]
  orders     ProductionOrder[]

  @@index([active])
  @@index([deletedAt])
  @@index([nameKey])
}

model RecipeLine {
  id       String  @id @default(cuid())
  recipeId String
  itemId   String
  qty      Decimal @db.Decimal(14, 3)
  note     String?

  recipe Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  item   StockItem @relation(fields: [itemId], references: [id])

  @@unique([recipeId, itemId])
}

enum ProductionStatus {
  in_progress /// დაწყებულია — მარაგი ჯერ არ შეცვლილა
  done        /// დასრულდა — ნედლეული ჩამოიწერა, პროდუქტი დაემატა
  cancelled
}

/// ერთი პარტია — რეცეპტის N-ჯერ გატარება კონკრეტულ ლოკაციაზე.
model ProductionOrder {
  id String @id @default(cuid())
  no Int    @unique @default(autoincrement())

  recipeId   String
  locationId String

  /// რამდენჯერ ტარდება რეცეპტი (4 × 100 = 400 გუნდა)
  batches    Decimal  @db.Decimal(14, 3)
  /// batches × recipe.outputQty
  plannedQty Decimal  @db.Decimal(14, 3)
  /// ფაქტობრივად რამდენი გამოვიდა
  actualQty  Decimal? @db.Decimal(14, 3)

  status ProductionStatus @default(in_progress)
  note   String?

  startedById   String?
  finishedById  String?
  cancelledById String?

  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe   Recipe           @relation(fields: [recipeId], references: [id])
  location StockLocation    @relation(fields: [locationId], references: [id])
  lines    ProductionLine[]

  @@index([status, startedAt])
  @@index([locationId, status])
}

/// ნედლეულის ასლი პარტიის მომენტისთვის — რეცეპტის მერე შეცვლა
/// ძველ პარტიას არ ცვლის.
model ProductionLine {
  id                String @id @default(cuid())
  productionOrderId String
  itemId            String

  qtyPlanned Decimal  @db.Decimal(14, 3)
  qtyUsed    Decimal? @db.Decimal(14, 3)

  order ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  item  StockItem       @relation(fields: [itemId], references: [id])

  @@unique([productionOrderId, itemId])
}


/// კომბოს მდგომარეობა კონკრეტულ ფილიალში.
/// ჩანაწერის არარსებობა = ხელმისაწვდომია (ნაგულისხმევი) — იგივე წესი, რაც BranchProduct-ში.
model BranchCombo {
  id       String @id @default(cuid())
  branchId String
  comboId  String

  /// false = ამ ფილიალში დროებით არ იყიდება
  available Boolean @default(true)

  note      String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  combo  Combo  @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@unique([branchId, comboId])
  @@index([comboId, available])
  @@index([branchId, available])
}
